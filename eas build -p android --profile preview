3️⃣ BookAppointment.js (حجز موعد)

import React, { useState } from "react";
import { View, Text, TextInput, Button, StyleSheet } from "react-native";

export default function BookAppointment({ route }) {
  const { hospital } = route.params;
  const [name, setName] = useState("");
  const [doctor, setDoctor] = useState("");
  const [time, setTime] = useState("");

  const handleBook = () => {
    if (!name || !doctor || !time) {
      alert("يرجى ملء جميع الحقول");
      return;
    }
    // هنا يمكن ربط Firebase لتخزين المواعيد
    alert(`تم حجز موعد في ${hospital.name} مع ${doctor} عند ${time}`);
  };

  return (
    <View style={styles.container}>
      <Text style={styles.title}>حجز موعد في {hospital.name}</Text>

      <TextInput
        style={styles.input}
        placeholder="اسمك"
        value={name}
        onChangeText={setName}
      />
      <TextInput
        style={styles.input}
        placeholder="اسم الطبيب"
        value={doctor}
        onChangeText={setDoctor}
      />
      <TextInput
        style={styles.input}
        placeholder="وقت الموعد"
        value={time}
        onChangeText={setTime}
      />

      <Button title="احجز الآن" onPress={handleBook} />
    </View>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, padding: 20 },
  title: { fontSize: 20, fontWeight: "bold", marginBottom: 20 },
  input: {
    borderWidth: 1,
    borderColor: "#aaa",
    padding: 10,
    borderRadius: 8,
    marginBottom: 15,
  },
});


